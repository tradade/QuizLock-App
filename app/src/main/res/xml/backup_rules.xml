<?xml version="1.0" encoding="utf-8"?>
<!-- Defense in depth: the app has allowBackup=false, and this file also excludes
     the local database and preferences from any legacy backup transport. -->
<full-backup-content>
    <exclude domain="database" path="quizgate.db" />
    <exclude domain="database" path="quizgate.db-wal" />
    <exclude domain="database" path="quizgate.db-shm" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
